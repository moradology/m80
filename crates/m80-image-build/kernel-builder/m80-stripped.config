# m80 stripped kernel configuration for Linux 6.1.x LTS
#
# This file is the canonical stripped-kernel config for m80-ci9i.2.
# Keep-list and drop-list are derived from docs/design/stripped-kernel.md.
#
# Cross-epic constraint (non-negotiable):
#   CONFIG_OVERLAY_FS=y and CONFIG_OVERLAY_FS_XINO_AUTO=y are required by
#   m80-f2zc.5 (storage-pivot epic). Removing either symbol breaks the overlay
#   rootfs mount and makes the storage pivot entirely non-functional.
#
# Build with: make olddefconfig && make vmlinux
# (olddefconfig fills any symbols absent here with safe defaults)

# =============================================================================
# KEEP LIST — must be =y (built-in, not module)
# =============================================================================

# Core VM communication
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS_COMMON=y

# Block and network virtio
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_BLK_MQ_VIRTIO=y

# Firecracker's non-PCI x86_64 path describes virtio-mmio devices on the kernel
# command line. ACPI requires CONFIG_PCI even when Firecracker's PCI transport is
# disabled, so this stripped kernel stays on the legacy-MMIO path deliberately.
# CONFIG_ACPI is not set
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y
# NON-NEGOTIABLE: required by m80-f2zc.5 storage-pivot; absent from stock kernel
CONFIG_OVERLAY_FS_XINO_AUTO=y

# Device management
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Console and diagnostics
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PRINTK=y

# Entropy (required by guestd crypto paths)
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_RANDOM_TRUST_CPU=y

# Process and memory basics
CONFIG_BINFMT_ELF=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y

# Systemd API filesystems and event primitives
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_FHANDLE=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_INOTIFY_USER=y

# Security framework (without MAC policies)
CONFIG_SECURITY=y

# =============================================================================
# DROP LIST — explicitly off (reduces decompressed size + boot latency)
# =============================================================================

# Transport and bus
# CONFIG_PCI is not set
# CONFIG_PCI_MSI is not set
# CONFIG_PCCARD is not set
# CONFIG_AGP is not set
# CONFIG_DMI is not set
# CONFIG_EFI is not set

# Filesystems (beyond the keep list)
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_NILFS2_FS is not set
# CONFIG_REISERFS_FS is not set
# CONFIG_JFS_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_OCFS2_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CIFS is not set
# CONFIG_SMB_SERVER is not set
# CONFIG_FUSE_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_CRAMFS is not set
# CONFIG_ROMFS_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_HFS_FS is not set
# CONFIG_HFSPLUS_FS is not set

# Network protocols (beyond IPv4)
# CONFIG_IPV6 is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_ATALK is not set
# CONFIG_DECNET is not set
# CONFIG_TIPC is not set
# CONFIG_RDS is not set
# CONFIG_SCTP is not set
# CONFIG_DCCP is not set
# CONFIG_L2TP is not set
# CONFIG_PPTP is not set
# CONFIG_WIRELESS is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_NFC is not set
# CONFIG_BLUETOOTH is not set

# USB
# CONFIG_USB is not set
# CONFIG_USB_SUPPORT is not set

# Sound
# CONFIG_SOUND is not set
# CONFIG_SND is not set

# Graphics
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_VGA_CONSOLE is not set
# CONFIG_LOGO is not set

# Input devices
# CONFIG_INPUT is not set
# CONFIG_HID is not set
# CONFIG_HID_GENERIC is not set
# CONFIG_USB_HID is not set

# Storage controllers not used
# CONFIG_ATA is not set
# CONFIG_SCSI_LOWLEVEL is not set
# CONFIG_RAID6_PQ is not set
# CONFIG_MD is not set
# CONFIG_DM is not set

# Platform and IPMI
# CONFIG_IPMI_HANDLER is not set
# CONFIG_HWMON is not set
# CONFIG_WATCHDOG is not set
# CONFIG_RTC_CLASS is not set

# Security modules (MAC — adds latency with no benefit for single-workload guest)
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_SECURITY_APPARMOR is not set
# CONFIG_SECURITY_TOMOYO is not set
# CONFIG_SECURITY_SMACK is not set
# CONFIG_IMA is not set
# CONFIG_EVM is not set

# Debugging and tracing
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_KGDB is not set
# CONFIG_KDB is not set
# CONFIG_KPROBES is not set
# CONFIG_FTRACE is not set
# CONFIG_TRACING is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_PROFILING is not set
# CONFIG_OPROFILE is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_KEXEC is not set

# Misc
# CONFIG_MODULES is not set
# CONFIG_KALLSYMS is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_SWAP is not set
# CONFIG_HIBERNATION is not set
# CONFIG_SUSPEND is not set
# CONFIG_PM is not set
