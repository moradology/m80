      "owner": "release-operator",
      "blocks_next_release": false,
      "opens_bead": false,
      "pages_maintainer": false,
      "requires_manual_confirmation": false,
      "retry_count": 1,
      "repair_command": "python3 scripts/release_freshness.py --docs-root . --json",
      "safe_summary_fields": [
        "failure_class",
        "repository",
        "url",
        "release_tag",
        "run_id",
        "repair_command"
      ]
    },
    {
      "id": "stale-latest",
