    {
      "id": "network",
      "title": "Network, DNS, or HTTP failure",
      "owner_action": "operator",
      "action_kind": "retry",
      "likely_failing_command": "curl -fsSL https://github.com/moradology/m80/releases/latest/download/install.sh | sudo sh",
      "diagnostic_command": "curl -I https://github.com/moradology/m80/releases/latest",
      "repair_command": "curl -fsSL https://github.com/moradology/m80/releases/latest/download/install.sh | sudo sh",
      "source_mappings": [
        {
          "kind": "test",
          "ref": "scripts/test-stable-latest-bootstrap.py::test_rejects_http_failure_before_handoff_json"
        },
        {
          "kind": "test",
          "ref": "scripts/test-release-bundle.py::test_rendered_install_script_download_failures_are_diagnosable_before_extract"
        }
      ],
      "verifier_codes": {
        "asset_index": [
          "download_failed",
          "download_spawn_failed",
          "local_read_failed",
          "redirect_unsupported",
          "unsupported_url"
        ],
        "error_envelope": [
          "release_material_fetch"
        ]
      }
    },
    {
